[Unit]
Description=XAUUSD Trading Bot (M5_SCALP + M15_INTRADAY)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/xauusd-bot
ExecStart=/usr/bin/python3 -u /opt/xauusd-bot/bot.py --env /opt/xauusd-bot/.env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
