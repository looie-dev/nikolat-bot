# === Broker Configuration ===
# Chọn sàn demo: "oanda", "capital", hoặc "paper" (giả lập cục bộ)
BROKER_PROVIDER=paper
BROKER_ENV=demo

# --- OANDA Practice (https://www.oanda.com) ---
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_INSTRUMENT=XAU_USD

# --- Capital.com Demo (https://capital.com) ---
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_EPIC=GOLD

# --- Paper Mode (chạy thử không cần tài khoản sàn) ---
PAPER_INITIAL_BALANCE=100
PAPER_STATE_FILE=data/paper_state.json
# 100 = chuẩn 1 lot Exness/MT5 (0.01 lot = 1 oz, $1 chạy = $1); 1 = chuẩn Capital.com (1 unit = 1 oz)
PAPER_CONTRACT_SIZE=100

# === Telegram Notifications ===
# Tạo bot qua @BotFather -> lấy TOKEN; nhắn tin cho bot rồi mở
# https://api.telegram.org/bot<TOKEN>/getUpdates để lấy chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STATUS_INTERVAL_MINUTES=60

# === Strategy (Multi-Confluence Trend Pullback) ===
# Có thể chạy đồng thời nhiều mode bằng STRATEGY_MODES (preset: m5_scalp, m15_intraday, h1_swing, m15_active)
# Để trống STRATEGY_MODES nếu muốn tự cấu hình từng tham số bên dưới
STRATEGY_MODES=m5_scalp,m15_intraday
TIMEFRAME=M15
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
ATR_PERIOD=14
ADX_PERIOD=14
ADX_MIN=18.0
PULLBACK_LOOKBACK=5
PULLBACK_ATR_TOLERANCE=0.45
SL_ATR_MULT=1.0
RR_RATIO=2.0
MIN_SL_USD=0.0
MAX_SL_USD=0.0
MAX_TP_USD=0.0
BREAKEVEN_ATR_TRIGGER=0.0
USE_SESSION_FILTER=true
SESSION_START_UTC=7
SESSION_END_UTC=17

# === Risk Management ===
RISK_PERCENT=10.0
# Đặt FIXED_SIZE > 0 nếu muốn đánh khối lượng cố định, để 0 nếu muốn bot tự tính theo % vốn
FIXED_SIZE=0.0
MAX_SIZE=0.10
MAX_OPEN_POSITIONS=2
# Đặt 0 để không giới hạn số lệnh mỗi ngày
MAX_DAILY_TRADES=0
MAX_DAILY_LOSS_PERCENT=25.0
MAX_SPREAD_USD=0.80
NEWS_BUFFER_MINUTES=15
COOLDOWN_CANDLES=2
ALLOW_OPPOSITE_POSITIONS=false

# === Runtime ===
POLL_INTERVAL_SECONDS=15
DRY_RUN=false
LOG_LEVEL=INFO
